[ext_resource type="Script" path="res://scripts/ui/main.gd" id="1"]
[ext_resource type="Script" path="res://scripts/ui/radar_display.gd" id="2"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_radar"]
bg_color = Color(0.028, 0.085, 0.074, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
