[gd_resource type="Resource" script_class="TaskDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/task_definition.gd" id="1"]

[resource]
script = ExtResource("1")
id = "task.first_recon"
display_name = "首关：确认海峡接触"
ship_id = "ship.haven"
aircraft_id = "aircraft.kestrel"
target_contact_id = "contact.alpha"
objective = "识别指定接触，并让指挥官安全返回。"
background = "群岛航路 / 原型叙事\n\n岛屿将海面分割成狭窄的航道。远处的舰影藏在地形背后，指令部收到的报告往往比船只的行动慢一步。\n\n你既是舰桥指挥官，也能亲自驾驶舰载侦察机。雷达上的亮点不能替你做决定；需要重复观测，必要时从空中确认。\n\n今天，一条海峡接触报告送到了你的终端。先接受命令，再驾驶舰船离港。你只有一条命；出击后，安全回收比一张漂亮的战果记录更重要。\n\n此文本用于首关原型，正式时代、阵营和长篇剧情尚未定稿。"
command_source = "群岛指令部 / CIC"
briefing = "海峡出现身份未明的 A1 接触。驾驶舰船离港后，主动搜索并确认身份；必要时亲自出击侦察，再安全回收。\n此关不以击沉目标为完成条件。不要把未知回波当作开火许可。"
operational_notes = "舰桥 → 配置出击 → 切换等待 → 飞行侦察 → 返航降落 → 结算。\n出击期间母舰继续承受风险；注意舰体、燃油与回收条件。\n当前原型允许母舰沉没后转降友方机场；完整战役的一命规则以后续计划为准。"
